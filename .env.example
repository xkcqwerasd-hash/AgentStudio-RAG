# ==============================================================================
# AgentStudio-RAG — Production Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Generate secure secrets using: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment & Identity Configuration
# ------------------------------------------------------------------------------
# Options: 'local' (zero-login single-user SQLite) or 'server' (multi-tenant PostgreSQL)
DEPLOYMENT_MODE=server

# HMAC-SHA256 Secret for signing Server Bearer Tokens (REQUIRED for Server mode)
# Generate via: openssl rand -hex 32
SERVER_AUTH_SECRET=change_me_to_a_secure_random_64_character_hex_secret_in_production

# 32-byte Base64 key for symmetric Fernet encryption of model API Keys
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_ENCRYPTION_KEY=change_me_to_a_secure_fernet_32byte_base64_encryption_key==

# Allow public registration in Server mode (true/false)
# Set to false for private organizational deployments
SERVER_ALLOW_REGISTRATION=false

# Automatically promote first registered user to administrator (true/false)
# Recommended 'false' in production; initialize admin via CLI instead
AUTO_FIRST_USER_ADMIN=false

# Optional whitelist of trusted internal hostnames or host:port combinations (comma-separated)
# Allowed strictly for administrator-configured system public models (e.g. internal vLLM / Ollama clusters)
# Format: "host1:port1,host2:port2,hostname" (e.g., "vllm-service.internal:8000,ollama-cluster:11434")
# Cloud metadata addresses (e.g. 169.254.169.254) are permanently forbidden even if declared here.
# Default: empty (prohibits all internal/private addresses in Server mode)
SERVER_TRUSTED_INTERNAL_HOSTS=

# ------------------------------------------------------------------------------
# 2. Server Mode Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=agentstudio
POSTGRES_PASSWORD=change_me_to_a_secure_postgres_password
POSTGRES_DB=agentstudio_rag
DATABASE_URL=postgresql+asyncpg://agentstudio:change_me_to_a_secure_postgres_password@postgres:5432/agentstudio_rag

# ------------------------------------------------------------------------------
# 3. Network & Gateway Configuration
# ------------------------------------------------------------------------------
# Host port mapping for Nginx gateway (default: 8080 to avoid conflicts with port 80)
HTTP_PORT=8080

# Uvicorn backend worker processes (recommended: 2-4 for server, 1 for local)
UVICORN_WORKERS=4

# ------------------------------------------------------------------------------
# 4. LLM & Inference Provider Defaults
# ------------------------------------------------------------------------------
# Provider: 'openai' (compatible with DeepSeek, Moonshot, Qwen, vLLM) or 'test_double'
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 5. Embedding & Reranker Settings
# ------------------------------------------------------------------------------
# Options: 'local_bge' (in-container ONNX), 'openai', 'test_double'
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512

# Cross-Encoder Reranker
RERANKER_ENABLED=true
RERANKER_PROVIDER=local_onnx
RERANKER_MODEL_NAME=Xenova/bge-reranker-base
