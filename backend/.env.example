# ==========================================
# AgentStudio-RAG Configuration Template
# ==========================================

# Project
PROJECT_NAME=AgentStudio-RAG
DEBUG=true

# Database (Default to SQLite for instant local runs without external dependencies)
# For PostgreSQL + pgvector: postgresql+asyncpg://postgres:postgres@localhost:5432/agentstudio_rag
DATABASE_URL=sqlite+aiosqlite:///./data/storage/agentstudio_rag.db

# LLM Configuration (OpenAI-compatible)
# Options: "openai" (uses real API below) or "test_double" (deterministic offline mock)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Embedding Configuration
# Options: "test_double" (built-in fast deterministic vector projection) or "openai" (remote API)
EMBEDDING_PROVIDER=test_double
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# RAG Ingestion Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=20
SIMILARITY_THRESHOLD=0.3
